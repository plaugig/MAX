<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/chatsListFragment">
    <fragment
        android:id="@+id/chatsListFragment"
        android:name="com.example.max.ui.chatsList.ChatsListFragment"
        android:label="Chats"
        tools:layout="@layout/chats_list_fragment">
        <action
            android:id="@+id/action_chats"
            app:destination="@id/chatFragment" />
        <action
            android:id="@+id/action_chatsListFragment_to_registrationFragment"
            app:destination="@id/registrationFragment" />
        <action
            android:id="@+id/action_chatsListFragment_to_userSearchFragment"
            app:destination="@id/userSearchFragment" />
    </fragment>

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.example.max.ui.chat.ChatFragment"
        android:label="Chat"
        tools:layout="@layout/chat_fragment">
        <action
            android:id="@+id/action_chatFragment_to_chatsListFragment"
            app:destination="@id/chatsListFragment" />
    </fragment>

    <fragment
        android:id="@+id/registrationFragment"
        android:name="com.example.max.ui.entrance.registration.RegistrationFragment"
        android:label="Registration"
        tools:layout="@layout/authorization_fragment" >
        <action
            android:id="@+id/action_registrationFragment_to_authorizationFragment"
            app:destination="@id/authorizationFragment" />
    </fragment>

    <fragment
        android:id="@+id/userSearchFragment"
        android:name="com.example.max.ui.searchChat.UserSearchFragment"
        android:label="Поиск пользователей"
        tools:layout="@layout/user_search_fragment">
        <action
            android:id="@+id/action_userSearchFragment_to_chatFragment"
            app:destination="@id/chatFragment"
            app:popUpTo="@id/userSearchFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment android:id="@+id/authorizationFragment"
        android:name="com.example.max.ui.entrance.autorization.AuthorizationFragment"
        android:label="autorization"
        tools:layout="@layout/authorization_fragment">
</fragment>

</navigation>